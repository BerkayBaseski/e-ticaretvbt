# Backend Environment Configuration Placeholder

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eticaret_db
DB_USER=postgres
DB_PASSWORD=postgres_password_placeholder
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/eticaret_db?schema=public

# JWT Security
JWT_SECRET=super_secret_jwt_key_placeholder
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_placeholder
REFRESH_TOKEN_EXPIRATION=30d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
